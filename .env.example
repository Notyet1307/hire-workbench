# Node 24 LTS; all paths relative to this project directory.
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
SEED_DEMO=true
AI_MODE=rules
# For access through Tailscale/LAN, set HOST=0.0.0.0, an exact APP_ORIGIN,
# and a random access token of at least 16 characters. The UI has a login form.
APP_ORIGIN=http://127.0.0.1:3000
APP_ACCESS_TOKEN=
# Optional: OpenAI-compatible /v1 endpoint. Supply your own provider/model ID.
# Real provider credentials stay on the server, never in VITE_ variables.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=60000
LLM_JSON_MODE=json_object
