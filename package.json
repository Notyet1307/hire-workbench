{
  "name": "hire-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chinese evidence-based recruiting workbench, inspired by WhaleHire",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch --import tsx --env-file-if-exists=.env src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.mjs",
    "e2e": "playwright test",
    "verify": "node scripts/verify.mjs",
    "pack:source": "node scripts/package.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.3.0",
    "@fastify/static": "^8.3.0",
    "fastify": "^5.6.2",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.11.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "unpdf": "^1.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "archiver": "^7.0.1",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  }
}
